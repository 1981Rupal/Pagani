# Pagani AI Atelier — Environment Configuration Reference
#
# Backend configuration (.env in backend/):
#   APP_NAME=Pagani AI Atelier API
#   AI_PROVIDER=groq # default: "groq", or "mock" / "ollama"
#   GROQ_API_KEY=
#   GROQ_MODEL=openai/gpt-oss-120b
#   GROQ_TIMEOUT_SECONDS=90
#   GROQ_MAX_RETRIES=3
#   FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173
#   MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/?retryWrites=true&w=majority
#   MONGODB_DATABASE=pagani_atelier
#
# Frontend configuration (.env.local in frontend/):
#   NEXT_PUBLIC_ATELIER_API_URL=http://localhost:8000
