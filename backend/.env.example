APP_NAME=Pagani AI Atelier API
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=90
GROQ_MAX_RETRIES=3
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional alternative providers
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# MongoDB Atlas Cloud Database Configuration
# Format: mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DATABASE=pagani_atelier
